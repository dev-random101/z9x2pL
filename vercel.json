{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python@0.0.1",
      "includeFiles": ["data/processed/actuals.csv", "data/processed/forecasts.csv"]
    }
  }
}
